; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
run/print_header=false
config/name="NEC 2023 Journeyman Challenge"
config/description="NEC 2023 journeyman electrician exam trainer."
config/version="1.0.5"
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"
; Saves go to %APPDATA%\NEC2023JourneymanChallenge, not %APPDATA%\Godot\app_userdata\...
; UserDirMigration copies the old folder's settings and progress over once.
config/use_custom_user_dir=true
config/custom_user_dir_name="NEC2023JourneymanChallenge"
boot_splash/bg_color=Color(0.008, 0.016, 0.031, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/splash.png"
boot_splash/stretch_mode=1
boot_splash/minimum_display_time=600

[audio]

general/text_to_speech=true

[input_devices]

; Touch is handled directly: AnswerCard tracks ScreenTouch with a slop check,
; Buttons take ScreenTouch natively, and TouchScroll (src/ui/touch_scroll.gd)
; drag-scrolls every ScrollContainer, because Godot's own ScrollContainer and
; PopupMenu react only to mouse events. Mouse emulation would double-fire taps.
;
; NOTE: these comments MUST start with ";", not "#". project.godot is parsed by
; ConfigFile, whose only comment character is ";". With "#" the two comment lines
; were glued onto the next setting's NAME, producing a junk key and leaving
; emulate_mouse_from_touch at Godot's default of TRUE - which silently routes
; every tap through the mouse branch in answer_card.gd, whose release handler
; has no drag-slop check, so scrolling off an answer card selects it.
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[display]

window/size/mode=2
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.016, 0.031, 1.0)
