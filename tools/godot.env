# The Godot build every script and CI job uses. Sourced by bash
# (tools/verify.sh, tools/pipeline/build_question_bank.sh, .github/workflows/verify.yml)
# and read by Python (tools/godot_env.py). KEY=value lines only; ${GODOT_VERSION} expands.
GODOT_VERSION=4.7.2
GODOT_BINARY=Godot_v${GODOT_VERSION}-stable_win64_console.exe
GODOT_EDITOR=Godot_v${GODOT_VERSION}-stable_win64.exe
