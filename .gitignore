# Godot 4 — regenerate on open, never commit
.godot/
export_presets.cfg.bak
*.translation

# Godot editor binaries live here but are ~180MB of vendored toolchain.
# Keep them out of history; re-download or re-link if you need them.
/Godot_v*.exe
/Godot_v*.zip

# Build output
/build/
*.apk
*.aab
*.idsig
*.pck
*.exe
*.TMP
*.tmp

# Generated speech is derived from question_bank.json + pregenerate_speech.py.
# ~360MB of mp3s at 96 kbps. Regenerate with: python tools/speech/pregenerate_speech.py --bundle
/assets/speech/

# Backups are throwaway; git history is the backup.
*.bak
*.bak.*

# Scratch output from OCR/audit tooling
__pycache__/
/tools/**/*.png
/tools/**/*.png.import
/tools/*.txt

# Local editor / OS noise
/.vscode/
Thumbs.db
desktop.ini
.DS_Store
*.log
/.audit_tmp/

# Release packages (docs/RELEASE.md)
/release/

# Private working notes (agent board, personal to-dos); public audits live in docs/audits/
/notes/
