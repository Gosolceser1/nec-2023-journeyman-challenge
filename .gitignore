# Godot 4 — regenerate on open, never commit
.godot/
.import/
export_presets.cfg.bak
*.translation

# Godot editor binaries live here but are 172MB of vendored toolchain.
# Keep them out of history; re-download or re-link if you need them.
/Godot_v*.exe
/Godot_v*.zip

# Build output
/build/
*.apk
*.aab
*.idsig
*.pck
*.exe
*.TMP
*.tmp

# Generated speech is derived from question_bank.json + pregenerate_speech.py.
# ~138MB of mp3s at 96 kbps. Regenerate with: python tools/speech/pregenerate_speech.py --bundle
/assets/speech/

# Backups are throwaway; git history is the backup.
/question_bank.bak*.json
*.bak
*.bak.*

# Scratch output from OCR/audit tooling
__pycache__/
/tools/**/*.png
/tools/**/*.png.import
/tools/*.txt
/tools/anomalies.json
/tools/out_*.txt

# Local editor / OS noise
/.vscode/
Thumbs.db
desktop.ini
.DS_Store
*.log
/.audit_tmp/
