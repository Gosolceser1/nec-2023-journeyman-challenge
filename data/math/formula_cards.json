				{"t": "text", "p": [36, 84], "text": "I", "size": 28, "color": "sky", "bold": true},
				{"t": "text", "p": [84, 84], "text": "R", "size": 28, "color": "emerald", "bold": true}
			]},
			"vars": [
				{"sym": "E", "meaning": "Voltage", "unit": "volts (V)"},
				{"sym": "I", "meaning": "Current", "unit": "amps (A)"},
				{"sym": "R", "meaning": "Resistance", "unit": "ohms (Ω)"}
			],
			"tip": "Cover the letter you want. Letters side by side: multiply. One over the other: divide.",
			"calc": "Type the top number, press ÷, type the bottom number, press =.",
			"example": {"type": "ohm_current", "inputs": {"E": 120, "R": 15}}
		},
